{
  "schema_version": "0.2",
  "defaults": {
    "commit_actor": "human_approved_agent_assisted",
    "push_actor": "franck_user_pr_author",
    "pr_actor": "franck_user_pr_author",
    "review_actor": "mergeguez_review",
    "merge_actor": "user_api",
    "promotion_merge_actor": "user_api"
  },
  "branch_policies": [
    {
      "name": "feature_to_dev",
      "base_refs": ["dev"],
      "head_patterns": ["aloeil/*"],
      "pr_actor": "franck_user_pr_author",
      "review_actor": "mergeguez_review",
      "merge_actor": "user_api",
      "native_review_requires_distinct_author": true,
      "exact_pr_base_head_sha_required": true,
      "auto_merge": {
        "enabled": false,
        "delete_branch_after_merge": false
      }
    },
    {
      "name": "dev_to_stable",
      "base_refs": ["main"],
      "head_refs": ["dev"],
      "pr_actor": "franck_user_pr_author",
      "review_actor": "mergeguez_review",
      "merge_actor": "user_api",
      "native_review_requires_distinct_author": true,
      "exact_pr_base_head_sha_required": true,
      "auto_merge": {
        "enabled": false,
        "delete_branch_after_merge": false
      }
    }
  ],
  "profiles": {
    "human_approved_agent_assisted": {
      "kind": "git_identity",
      "roles": ["commit_actor"],
      "status": "available",
      "credential_location": "repo_git_config",
      "requires_explicit_approval": true,
      "secrets_in_repo": false,
      "attribution": "human-approved agent-assisted commit"
    },
    "franck_user_pr_author": {
      "kind": "github_app_user_access_token",
      "roles": ["push_actor", "pr_actor"],
      "status": "available_private_host_config",
      "expected_login": "fr-meyer",
      "credential_location": "private_host_config",
      "requires_explicit_approval": true,
      "secrets_in_repo": false,
      "attribution": "GitHub user-authored feature branches and pull requests"
    },
    "mergeguez_review": {
      "kind": "github_app_installation_broker",
      "roles": ["review_actor"],
      "status": "available_host_broker",
      "bot_login": "mergeguez[bot]",
      "forbidden_pr_author_logins_for_native_review": ["mergeguez[bot]"],
      "credential_location": "host_broker",
      "requires_explicit_approval": false,
      "secrets_in_repo": false,
      "attribution": "exact-head independent review and check evidence"
    },
    "user_api": {
      "kind": "github_app_user_access_token",
      "roles": ["merge_actor", "promotion_merge_actor"],
      "status": "available_private_host_config",
      "expected_login": "fr-meyer",
      "credential_location": "private_host_config",
      "requires_explicit_approval": true,
      "exact_pr_base_head_sha_required": true,
      "secrets_in_repo": false,
      "attribution": "approving GitHub user recorded as merge actor"
    }
  }
}
