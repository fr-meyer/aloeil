<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- ATD system images omit DocumentsUI. This test-only picker lets the
             Activity-result flow stay pending across MainActivity recreation. -->
        <activity
            android:name="org.aloeil.app.SyntheticDocumentPickerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_DOCUMENT" />
                <action android:name="android.intent.action.OPEN_DOCUMENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <provider
            android:name="org.aloeil.app.SyntheticCsvProvider"
            android:authorities="org.aloeil.app.test.syntheticcsv"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
